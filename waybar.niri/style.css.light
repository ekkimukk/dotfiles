/* =============================================================================
 *
 * Waybar configuration – тёплая светлая тема (бумажный фон)
 *
 * =========================================================================== */

/* -----------------------------------------------------------------------------
 * Colors definition – тёплый бумажный фон, приглушённые рамки
 * -------------------------------------------------------------------------- */
@define-color bg #fbf1c7;          /* тёплый бумажный (Gruvbox light) */
@define-color fg #282828;          /* тёмный текст */

/* Блеклые цвета для рамок (сохранены из предыдущей версии) */
@define-color highlight #b8a080;
@define-color yellow   #b0a070;
@define-color red      #a07070;
@define-color orange   #b08060;
@define-color blue     #708090;
@define-color green    #808060;
@define-color purple   #806080;
@define-color aqua     #608080;
@define-color gray     #888888;

/* -----------------------------------------------------------------------------
 * Keyframes (адаптированы под светлый фон)
 * -------------------------------------------------------------------------- */

@keyframes blink-warning {
  70% {
    color: @fg;
  }

  to {
    color: @fg;
    background-color: @orange;
  }
}

@keyframes blink-critical {
  70% {
    color: @fg;
  }

  to {
    color: @fg;
    background-color: @red;
  }
}

/* -----------------------------------------------------------------------------
 * Base styles
 * -------------------------------------------------------------------------- */

* {
  border: none;
  border-radius: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
}

/* Панель – прозрачная */
#waybar {
  background: transparent;
  color: @fg;
  font-family: "Aporetic Serif Mono";
  font-size: 13px;
}

/* Все модули – бумажный фон, закруглённые углы, рамки */
#mode,
#network,
#custom-keyboard-layout,
#idle_inhibitor,
#cpu,
#memory,
#backlight,
#pulseaudio,
#battery,
#clock,
#tray,
#custom-launcher,
#workspaces,
#window,
#custom-power {
  background-color: @bg;
  border-radius: 6px;
  border-width: 2px;
  border-style: solid;
  padding: 0.5rem 0.6rem;
  margin: 1px 0px;
}

/* -----------------------------------------------------------------------------
 * Индивидуальные цвета рамок (без прозрачности)
 * -------------------------------------------------------------------------- */

#custom-launcher {
  border-color: @highlight;
  margin-left: 10px;
  margin-right: 10px;
  color: @fg;
}

#workspaces {
  border-color: @yellow;
  font-size: 13px;
}

#workspaces button {
  border-radius: 0px;
  color: @fg;
  padding: 1px 2px;
  margin-right: 2px;
  margin-left: 2px;
  font-weight: normal;
  background: transparent;
}

#workspaces button.focused {
  background-color: transparent;
  color: @fg;
  font-weight: bold;
}

#workspaces button.urgent {
  background-color: transparent;
  color: @bg;          /* на бумажном фоне почти сливается, можно оставить */
}

#window {
  border-color: @blue;
}

#mode {
  border-color: @red;
  background-color: @bg;
  border-radius: 6px;
  color: @fg;
  margin-left: 5px;
  padding: 7px;
}

#network {
  border-color: @green;
}

#network.disconnected {
  color: @orange;
}

#custom-keyboard-layout {
  border-color: @purple;
}

#idle_inhibitor {
  border-color: @aqua;
}

#cpu {
  border-color: @orange;
}

#cpu.warning {
  color: @yellow;
}

#cpu.critical {
  color: @red;
}

#memory {
  border-color: @gray;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

#memory.warning {
  color: @yellow;
}

#memory.critical {
  color: @red;
  animation-name: blink-critical;
  animation-duration: 2s;
  padding-left: 5px;
  padding-right: 5px;
}

#backlight {
  border-color: @gray;
}

#pulseaudio {
  border-color: @blue;
}

#pulseaudio.muted {
  color: @orange;
}

#battery {
  border-color: @green;
}

#battery.warning {
  color: @yellow;
}

#battery.critical {
  color: @red;
}

#battery.warning.discharging {
  animation-name: blink-warning;
  animation-duration: 2s;
}

#battery.critical.discharging {
  animation-name: blink-critical;
  animation-duration: 2s;
}

#clock {
  border-color: @gray;
  color: @fg;
}

#tray {
  border-color: @purple;
  color: @fg;
}

#custom-power {
  border-color: @red;
  margin-left: 15px;
  margin-right: 15px;
  font-size: 15px;
  color: @red;
}
