/* =============================================================================
 *
 * Waybar configuration – тёплая светлая тема с зернистым фоном (из текстуры)
 *
 * =========================================================================== */

/* -----------------------------------------------------------------------------
 * Colors definition – тёплый бумажный фон, тёмные приглушённые рамки
 * -------------------------------------------------------------------------- */
@define-color bg #fbf1c7;          /* тёплый бумажный (Gruvbox light) */
@define-color fg #282828;          /* тёмный текст */

/* Цвета рамок – более тёмные, заметные на светлом фоне */
@define-color highlight #a67c52;   /* коричневато-оранжевый */
@define-color yellow   #b08a4a;    /* приглушённый золотой */
@define-color red      #9a4a4a;    /* кирпичный */
@define-color orange   #b06a3a;    /* тёплый оранжевый */
@define-color blue     #5a7a8a;    /* серо-синий */
@define-color green    #6a7a3a;    /* оливковый */
@define-color purple   #7a5a7a;    /* серо-фиолетовый */
@define-color aqua     #4a7a6a;    /* зеленовато-голубой */
@define-color gray     #7a7a7a;    /* нейтральный серый */

/* -----------------------------------------------------------------------------
 * Keyframes (адаптированы под светлый фон)
 * -------------------------------------------------------------------------- */

@keyframes blink-warning {
  70% {
    color: @fg;
  }

  to {
    color: @fg;
    background-color: @orange;
  }
}

@keyframes blink-critical {
  70% {
    color: @fg;
  }

  to {
    color: @fg;
    background-color: @red;
  }
}

/* -----------------------------------------------------------------------------
 * Base styles
 * -------------------------------------------------------------------------- */

* {
  border: none;
  border-radius: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
}

/* Панель – прозрачная */
#waybar {
  background: transparent;
  color: @fg;
  font-family: "Aporetic Serif Mono";
  font-size: 13px;
}

/* Все модули – бумажный фон + зернистая текстура (как в примере) */
#mode,
#network,
#custom-keyboard-layout,
#idle_inhibitor,
#cpu,
#memory,
#backlight,
#pulseaudio,
#battery,
#clock,
#tray,
#custom-launcher,
#workspaces,
#window,
#custom-power {
  background-color: @bg;
  /* Текстура зернистости – накладываем поверх фона */
  background-image: url("https://www.transparenttextures.com/patterns/otis-redding.png");
  background-repeat: repeat;
  background-size: auto;
  background-blend-mode: multiply;  /* мягкое смешивание с фоном */
  border-radius: 6px;
  border-width: 2px;
  border-style: solid;
  padding: 0.5rem 0.6rem;
  margin: 1px 0px;
}

/* -----------------------------------------------------------------------------
 * Индивидуальные цвета рамок
 * -------------------------------------------------------------------------- */

#custom-launcher {
  border-color: @highlight;
  margin-left: 10px;
  margin-right: 10px;
  color: @fg;
}

#workspaces {
  border-color: @yellow;
  font-size: 13px;
}

#workspaces button {
  border-radius: 0px;
  color: @fg;
  padding: 1px 2px;
  margin-right: 2px;
  margin-left: 2px;
  font-weight: normal;
  background: transparent;
}

#workspaces button.focused {
  background-color: transparent;
  color: @fg;
  font-weight: bold;
}

#workspaces button.urgent {
  background-color: transparent;
  color: @bg;
}

#window {
  border-color: @blue;
}

#mode {
  border-color: @red;
  background-color: @bg;   /* текстура наследуется от общего правила */
  border-radius: 6px;
  color: @fg;
  margin-left: 5px;
  padding: 7px;
}

#network {
  border-color: @green;
}

#network.disconnected {
  color: @orange;
}

#custom-keyboard-layout {
  border-color: @purple;
}

#idle_inhibitor {
  border-color: @aqua;
}

#cpu {
  border-color: @orange;
}

#cpu.warning {
  color: @yellow;
}

#cpu.critical {
  color: @red;
}

#memory {
  border-color: @gray;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

#memory.warning {
  color: @yellow;
}

#memory.critical {
  color: @red;
  animation-name: blink-critical;
  animation-duration: 2s;
  padding-left: 5px;
  padding-right: 5px;
}

#backlight {
  border-color: @gray;
}

#pulseaudio {
  border-color: @blue;
}

#pulseaudio.muted {
  color: @orange;
}

#battery {
  border-color: @green;
}

#battery.warning {
  color: @yellow;
}

#battery.critical {
  color: @red;
}

#battery.warning.discharging {
  animation-name: blink-warning;
  animation-duration: 2s;
}

#battery.critical.discharging {
  animation-name: blink-critical;
  animation-duration: 2s;
}

#clock {
  border-color: @gray;
  color: @fg;
}

#tray {
  border-color: @purple;
  color: @fg;
}

#custom-power {
  border-color: @red;
  margin-left: 15px;
  margin-right: 15px;
  font-size: 15px;
  color: @red;
}
