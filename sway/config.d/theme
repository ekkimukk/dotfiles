# Apply gtk theming
exec_always ~/.config/sway/scripts/import-gsettings

# Cursor theme
# seat seat0 xcursor_theme capitaine-cursors 24

# Set inner/outer gaps
gaps inner 4
gaps outer 0

# Hide titlebar on windows:
default_border pixel 2

# Default Font
# font pango:Noto Sans Regular 10
font pango:Iosevka 10

# Thin borders:
smart_borders off

# Set wallpaper:
output * background ~/pictures/walls/favourite/art1.jpg fill

# Title format for windows
for_window [shell="xdg_shell"] title_format "%title (%app_id)"
for_window [shell="x_wayland"] title_format "%class - %title"

# Flexoki Dark Color Palette
# class                 border    bground   text      indicator child_border
client.focused          #575653   #575653   #cecdc3   #575653   #575653
client.focused_inactive #2a2626   #2a2626   #878580   #2a2626   #2a2626
client.unfocused        #100f0f   #100f0f   #878580   #100f0f   #100f0f
client.urgent           #af3029   #100f0f   #cecdc3   #af3029   #af3029
client.placeholder      #100f0f   #100f0f   #cecdc3   #100f0f   #100f0f
client.background       #100f0f

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
bar {
    swaybar_command waybar
}
